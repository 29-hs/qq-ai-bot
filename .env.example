# 复制这个文件为 .env，填上你自己的值（.env 不要提交到 git）

# DeepSeek API Key，在 https://platform.deepseek.com/api_keys 创建
DEEPSEEK_API_KEY=

# NapCat 的 WebSocket Token（在 NapCat WebUI 的网络配置里自己设一个，留空表示不鉴权）
NAPCAT_TOKEN=

# 看图用的多模态模型 Key（可选）：硅基流动 https://cloud.siliconflow.cn
# 或智谱 https://open.bigmodel.cn （glm-4v-flash 免费）
# 填好后把 config.yaml 里 vision.enabled 改成 true
VISION_API_KEY=
